name = "moonbitstack/moonpug"

version = "0.1.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonpug"

license = "Apache-2.0"

keywords = [
  "template",
  "template-engine",
  "templating",
  "html",
  "html5",
  "pug",
  "jade",
  "markdown",
  "commonmark",
  "gfm",
  "markup",
  "jinja",
  "jinja2",
  "static-site-generator",
  "ssg",
  "code-generation",
  "render",
  "renderer",
  "view",
  "moonbit",
]

description = "A template engine for MoonBit: HTML, Pug and Markdown pages over one expression language."

source = "src"

import {
  "moonbitstack/moondate@0.1.0",
  "moonbitstack/moonmd@0.1.0",
  "moonbitstack/moonucd@0.1.2",
}

preferred_target = "wasm-gc"
