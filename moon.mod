name = "moonbitstack/moonpug"

version = "0.1.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonpug"

license = "Apache-2.0"

keywords = [
  "template",
  "template-engine",
  "templating",
  "html",
  "pug",
  "jade",
  "markdown",
  "render",
  "view",
  "moonbit",
]

description = "A template engine for MoonBit."

source = "src"

import {
  "moonbitstack/moondate@0.1.0",
  "moonbitstack/moonucd@0.1.2",
}

preferred_target = "wasm-gc"
