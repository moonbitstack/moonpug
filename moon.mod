name = "moonbitstack/moonpug"

version = "0.2.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonpug"

license = "Apache-2.0"

keywords = [
  "template",
  "template-engine",
  "templating",
  "html",
  "html5",
  "pug",
  "jade",
  "markdown",
  "commonmark",
  "gfm",
  "markup",
  "html-escape",
  "whitespace-control",
  "jinja",
  "jinja2",
  "twig",
  "django",
  "liquid",
  "slim",
  "static-site-generator",
  "ssg",
  "code-generation",
  "render",
  "renderer",
  "view",
  "moonbit",
]

description = "A template engine for MoonBit: HTML, Pug and Markdown pages over one expression language."

source = "src"

import {
  "moonbitstack/moondate@0.2.1",
  "moonbitstack/moonmd@0.2.1",
  "moonbitstack/moonjson@0.5.1",
  "moonbitstack/moonucd@0.2.1",
}

preferred_target = "wasm-gc"
