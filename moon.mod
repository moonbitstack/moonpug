name = "moonbitstack/moonpug"

version = "0.1.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonpug"

license = "Apache-2.0"

keywords = [ "template", "html", "pug", "markdown", "render", "moonbit" ]

description = "A template engine for MoonBit."

source = "src"

import {
